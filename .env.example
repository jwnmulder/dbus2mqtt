MQTT__HOST=localhost
MQTT__PORT=1883
MQTT__USERNAME=
MQTT__PASSWORD=

# MQTTS (TLS) options — set MQTT__TLS_ENABLED=true and MQTT__PORT=8883 to enable
# MQTT__TLS_ENABLED=true
# MQTT__TLS_CA_CERT=/path/to/ca.crt
# MQTT__TLS_CERT_FILE=/path/to/client.crt
# MQTT__TLS_KEY_FILE=/path/to/client.key
# MQTT__TLS_INSECURE=false
